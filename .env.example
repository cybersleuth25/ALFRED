ALFRED_USER_NAME="Your Name"
ALFRED_USER_LOCATION="Your City, Country"

# Telegram Bot configuration (Optional, for mobile remote control)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_ALLOWED_USER_ID="your_telegram_user_id_here"

# Gemini API Key (Optional, fallback for Telegram image analysis)
GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini API Key for Telegram image analysis (Optional, defaults to GEMINI_API_KEY)
GEMINI_TELEGRAM_API_KEY="your_gemini_telegram_api_key_here"

# Spotify OAuth (Optional, for media control)
# Get credentials from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret_here"
SPOTIFY_REFRESH_TOKEN="your_spotify_refresh_token_here"

# Google Calendar OAuth (Optional, syncs with Samsung & Google Calendar)
# Place downloaded credentials.json in project root OR fill credentials below:
# Run: python google_calendar_auth.py
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Weather API / OSINT configurations
USER_CITY="YourCity"
USER_COUNTRY="YourCountryCode"

# Piper TTS Voice (offline, ultra-fast — see models/piper/ for available voices)
# Options: en_GB-alan-medium, en_GB-northern_english_male-medium
PIPER_VOICE_MODEL="en_GB-alan-medium"

# Chatterbox TTS — Emotional voice with optional voice cloning (Resemble AI)
# Drop a 5-15s .wav file in models/voice_reference/ and set the path below
CHATTERBOX_VOICE_REF=""              # Path to voice reference .wav (empty = default voice)
CHATTERBOX_EXAGGERATION="0.5"        # Emotion intensity: 0.0 (flat) → 1.0 (dramatic)
CHATTERBOX_FAST_SKIP="true"          # Use fast Piper for short messages (<20 chars)

# Focus Mode — Auto Lo-Fi playlist (Spotify URI, plays when study mode activates)
OMEGA_PLAYLIST_URI="spotify:playlist:0vvXsWCC9xrXsKd4FyS8kM"

# Daily Schedule (24h format HH:MM — leave empty to disable)
SCHEDULE_FOCUS_START=""               # Auto-engage Protocol Omega (e.g., "07:00")
SCHEDULE_FOCUS_END=""                 # Auto-disengage focus (e.g., "12:00")
SCHEDULE_BEDTIME_WARNING="23:00"      # Bedtime wind-down reminder
SCHEDULE_BRIEFING_TIME=""             # Auto morning briefing (e.g., "07:05")
SCHEDULE_LOFI_ON_FOCUS="true"         # Auto-play LoFi when focus starts

# Hardcore Mode (instant kill distracting apps — no 15s warning)
HARDCORE_ON_BOOT="false"              # Start in hardcore mode by default

# --- LLM Configuration (Groq — free tier, all models free) ---
GROQ_API_KEY="your_groq_api_key_here"
LLM_MODEL="llama-3.3-70b-versatile"         # Power model (conversation, complex reasoning)
LLM_FAST_MODEL="llama-3.1-8b-instant"       # Fast model (tool calls, classification)

# --- Embedding Configuration ---
EMBEDDING_MODEL="all-MiniLM-L6-v2"          # Local sentence-transformers model (no API needed)

# --- Contextual Awareness Engine ---
CONTEXT_ENGINE_ENABLED="true"                # Enable/disable the context awareness daemon
CONTEXT_SCAN_INTERVAL="30"                   # Seconds between activity scans
CONTEXT_SNAPSHOT_INTERVAL="60"               # Seconds between DB snapshots
CONTEXT_INTERVENTION_COOLDOWN="300"          # Min seconds between proactive voice interventions (5 min)
CONTEXT_STUCK_THRESHOLD="600"                # Seconds on same screen before "stuck" detection (10 min)
CONTEXT_BREAK_THRESHOLD="5400"               # Seconds of continuous activity before break suggestion (90 min)
CONTEXT_AWAY_THRESHOLD="120"                 # Seconds before marking user as "away" (2 min)
